{
  "name": "@belikellwyd/vitepress-back-to-top-button",
  "type": "module",
  "version": "1.0.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/belikellwyd/vitepress-back-to-top-button"
  },
  "homepage": "https://belikellwyd.github.io/vitepress-back-to-top-button/",
  "description": "A lightweight Back-to-Top button Vue 3 component for VitePress. Features smooth scroll, progress ring indicating scroll percentage, dark/light theme support.",
  "main": "./dist/back-to-top-button.es.js",
  "module": "./dist/back-to-top-button.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/back-to-top-button.es.js",
      "default": "./dist/back-to-top-button.es.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/index.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build && copy src\\index.d.ts dist\\index.d.ts && copy src\\style.css.d.ts dist\\style.css.d.ts",
    "clean": "rimraf dist node_modules .vite .turbo",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.0.0"
  },
  "keywords": [
    "vitepress",
    "vitepress plugin",
    "vue",
    "vue3",
    "vue component",
    "back to top",
    "back-to-top button",
    "dark mode",
    "light theme",
    "vitepress enhancement",
    "vitepress ui",
    "vitepress component",
    "vitepress back to top"
  ],
  "author": "belikellwyd",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.3.14"
  }
}
